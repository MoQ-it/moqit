# The public DNS name of this server. Its A/AAAA record must point here
# before starting, so Caddy can obtain a Let's Encrypt certificate.
MEET_DOMAIN=meet.example.com

# Shared by the Meet app (to mint tokens) and the moqit node (to verify
# them). Generate a secret with: openssl rand -hex 32
MOQIT_API_KEY=meet
MOQIT_API_SECRET=

# Host ports. Caddy needs 80 and 443 to obtain the certificate.
HTTP_PORT=80
HTTPS_PORT=443
MOQ_PORT=4443

# Where Caddy keeps the certificate: the Let's Encrypt directory by default.
# Set to "local" when MEET_DOMAIN is localhost (Caddy's own CA, for testing).
CERT_ISSUER=acme-v02.api.letsencrypt.org-directory
